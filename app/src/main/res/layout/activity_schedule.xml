<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="20dp">

    <!-- Tiêu đề màn hình -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LỊCH CHẤM CÔNG"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"/>

    <!-- Header tiêu đề các cột -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="#E2E8F0"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ngày"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="Check-in"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="Check-out"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <Space
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:text="Bật"
            android:textColor="#475569"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"/>

    </LinearLayout>

    <!-- Danh sách lịch -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewLich"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        tools:listitem="@layout/item_lich_cham_cong"/>

    <!-- Nút LƯU LỊCH (Material Button dạng Primary CTA) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLuuLich"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="LƯU LỊCH"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#2563EB"
        app:cornerRadius="12dp"
        app:elevation="4dp"/>

</LinearLayout>